BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
# Local polling mode uses this directory for a small connection cache.
DATA_DIR=data
# Optional override:
# DATABASE_PATH=data/himoya.sqlite3
# Render webhook mode additionally requires a 16-256 character secret.
# Generate one locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=PASTE_A_RANDOM_SECRET_HERE
LOG_LEVEL=INFO
