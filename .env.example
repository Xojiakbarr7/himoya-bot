BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
# Local polling mode only
DATA_DIR=data
# Render webhook mode also requires a random secret (32-256 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=PASTE_A_RANDOM_SECRET_HERE
LOG_LEVEL=INFO

# Optional durable 72-hour history. Keep this URL secret; never commit real credentials.
HISTORY_DATABASE_URL=

# Optional: VirusTotal API v3 key authorized for your deployment/use.
# Only APK SHA-256 is queried after the owner consents. Files are never uploaded.
VIRUSTOTAL_API_KEY=
